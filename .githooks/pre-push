#!/bin/sh
#
# push の手前で止める。
#
# 「確かめた」と言いながら確かめずに出す、を何度も繰り返した。
# 決まりを文章で書いても守られないので、通り道を塞ぐ。
# ここを通らずに push はできない（--no-verify を使えば別だが、それは
# 「確かめずに出す」と自分で宣言することになる）。
#
# 中身は npm run check と同じ: 型チェック → テスト → 画面の sweep。
# npm 無しでも動くよう、node で直に起こす。
#
# ■ wip/ のブランチだけは、確かめずに通す
#
# ここは行き先を見ずに、どのブランチでも4分のテストを回していた。
# ローカルとクラウドの間で**作業中のものを渡す**のに毎回4分かかると、
# 渡すこと自体をやめる。実際、渡す道が無いので同じ作業を二度やっていた。
#
# wip/ は自分の作業を置くだけのブランチで、誰も取り込まない（CI も回らない）。
# **止める理由が無い。**ただし黙って通さない。確かめていないと言う。
set -e

pushing_wip=1
AAS_PUSH_RANGE=''
AAS_PUSH_SENDING=''
AAS_PUSH_CARRIES=0
# main と同じツリーかを見るための、押すブランチの sha と、ブランチ以外が混ざったか。
AAS_PUSH_BRANCH_SHAS=''
AAS_PUSH_OTHER=0
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/heads/wip/*) ;;
    *) pushing_wip=0 ;;
  esac
  # 突き合わせる相手は、ブランチを押すときの sha だけ。タグの sha は commit では
  # ないので、HEAD と比べると `v*` のタグで release を出す道が塞がる。
  case "$_local_ref" in
    refs/heads/*) AAS_PUSH_SENDING="$local_sha" ;;
  esac
  case "$local_sha" in
    *[!0]*)
      case "$_local_ref" in
        refs/heads/*) AAS_PUSH_BRANCH_SHAS="$AAS_PUSH_BRANCH_SHAS $local_sha" ;;
        *) AAS_PUSH_OTHER=1 ;;
      esac
      ;;
  esac
  # 消す push（sha が全部 0）だけなら、ワークツリーを運んでいない。確かめようがない。
  case "$local_sha" in
    *[!0]*) AAS_PUSH_CARRIES=1 ;;
  esac
  # ブランチを消す push（local_sha が全部 0）と、remote にまだ無いブランチは見ない。
  case "$local_sha$remote_sha" in
    *[!0]*)
      case "$remote_sha" in
        *[!0]*) AAS_PUSH_RANGE="$remote_sha..$local_sha" ;;
      esac
      ;;
  esac
done

if [ "$pushing_wip" = "1" ]; then
  echo "== wip/ のブランチなので、確かめずに通します（作業中のものを移すだけ）"
  echo "   ここを取り込むときは、取り込んだ先で確かめてください。"
  exit 0
fi

# git がフックへ渡す env を、確かめへ持ち込まない。
#
# git は pre-push に GIT_DIR・GIT_INDEX_FILE などを渡す。継いだまま試験を
# 回すと、一時の repository を作る試験が**走らせている repository** を
# 触りにいって落ちる。手で回すと通り、フックからだけ 21 件落ちた。
# **確かめの側が嘘をつくと、確かめを迂回する癖がつく。**
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_QUARANTINE_PATH
unset GIT_REFLOG_ACTION GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

# 文書だけの push は、そのまま出さない。
#
# ci.yml の paths-ignore は効かない（GitHub は pull_request の path 判定を
# PR 全体の差分で行うので、PR に一度でもコードが入っていれば当たらない）。
# この repo は push では回さないので、**開いている PR への文書だけの push は
# 毎回 1 回ぶん枠を食う**。実際に食った。
#
# 押す範囲は、上で読んだ remote_ref/local_sha から出す。remote にまだ
# ブランチが無い（_remote_sha が全部 0）ときは、範囲が決められないので見ない。
if [ -n "$AAS_PUSH_RANGE" ]; then
  reason=$(node scripts/docs-only-check.mjs "$AAS_PUSH_RANGE") || {
    echo "$reason"
    exit 1
  }
fi

# 押すツリーが、外に既に在る main と同じなら、確かめを飛ばす（scripts/same-as-main.mjs）。
#
# マージの後に作業のブランチを main へ合わせ直す push は、外に新しいものを何も出さない。
# それでも 12 分の確かめを回していた。出るものが無いなら、確かめるものも無い。
# 飛ばすのは「押すものが全部ブランチで、ツリーが全部 main と同じ」ときだけ。
if [ -n "$AAS_PUSH_BRANCH_SHAS" ]; then
  # shellcheck disable=SC2086
  if reason=$(node scripts/same-as-main.mjs "${1:-origin}" "$AAS_PUSH_OTHER" $AAS_PUSH_BRANCH_SHAS); then
    echo "$reason"
    exit 0
  fi
fi

# 確かめるワークツリーと、押すワークツリーを、同じものにする。
#
# pre-push が見るのは**いまの作業のワークツリー**で、押されるのは git が push の時点で
# 読み直した ref の先。実際にずれた（確かめが試験の段を終えたあとに次の作業を
# commit して、**一度も試験を通っていないものが通った顔で出た**）。
#
# 前に分かることは前に言う（汚れている・別のブランチを押している）。動いたかどうかは
# 後でしか分からないので、確かめの後に見る。
AAS_PUSH_BEFORE=''
if [ "$AAS_PUSH_CARRIES" = "1" ]; then
  AAS_PUSH_BEFORE=$(node scripts/pushed-tree-check.mjs before "$AAS_PUSH_SENDING") || {
    echo "$AAS_PUSH_BEFORE"
    exit 1
  }
fi

echo "== push の手前で確かめます（型チェック・テスト・画面）"
node scripts/check.mjs

reason=$(node scripts/pushed-tree-check.mjs after "$AAS_PUSH_SENDING" "$AAS_PUSH_BEFORE") || {
  echo "$reason"
  exit 1
}
