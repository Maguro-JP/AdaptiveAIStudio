#!/bin/sh
#
# push の手前で止める。
#
# 「確かめた」と言いながら確かめずに出す、を何度も繰り返した。
# 決まりを文章で書いても守られないので、通り道を塞ぐ。
# ここを通らずに push はできない（--no-verify を使えば別だが、それは
# 「確かめずに出す」と自分で宣言することになる）。
#
# 中身は npm run check と同じ: 型検査 → 検査 → 画面を押して回る。
# npm 無しでも動くよう、node で直に起こす。
#
# ■ wip/ のブランチだけは、確かめずに通す
#
# ここは行き先を見ずに、どのブランチでも4分の検査を回していた。
# ローカルとクラウドの間で**作業中のものを渡す**のに毎回4分かかると、
# 渡すこと自体をやめる。実際、渡す道が無いので同じ作業を二度やっていた。
#
# wip/ は自分の作業を置くだけのブランチで、誰も取り込まない（CI も回らない）。
# **止める理由が無い。**ただし黙って通さない。確かめていないと言う。
set -e

pushing_wip=1
while read -r _local_ref _local_sha remote_ref _remote_sha; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/heads/wip/*) ;;
    *) pushing_wip=0 ;;
  esac
done

if [ "$pushing_wip" = "1" ]; then
  echo "== wip/ のブランチなので、確かめずに通します（作業中のものを移すだけ）"
  echo "   ここを取り込むときは、取り込んだ先で確かめてください。"
  exit 0
fi

echo "== push の手前で確かめます（型検査・検査・画面）"
node scripts/check.mjs
