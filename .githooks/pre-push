#!/bin/sh
#
# push の手前で止める。
#
# 「確かめた」と言いながら確かめずに出す、を何度も繰り返した。
# 決まりを文章で書いても守られないので、通り道を塞ぐ。
# ここを通らずに push はできない（--no-verify を使えば別だが、それは
# 「確かめずに出す」と自分で宣言することになる）。
#
# 中身は npm run check と同じ: 型検査 → 検査 → 画面を押して回る。
# npm 無しでも動くよう、node で直に起こす。
#
# ■ wip/ のブランチだけは、確かめずに通す
#
# ここは行き先を見ずに、どのブランチでも4分の検査を回していた。
# ローカルとクラウドの間で**作業中のものを渡す**のに毎回4分かかると、
# 渡すこと自体をやめる。実際、渡す道が無いので同じ作業を二度やっていた。
#
# wip/ は自分の作業を置くだけのブランチで、誰も取り込まない（CI も回らない）。
# **止める理由が無い。**ただし黙って通さない。確かめていないと言う。
set -e

pushing_wip=1
AAS_PUSH_RANGE=''
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ -z "$remote_ref" ] && continue
  case "$remote_ref" in
    refs/heads/wip/*) ;;
    *) pushing_wip=0 ;;
  esac
  # 枝を消す push（local_sha が全部 0）と、remote にまだ無い枝は見ない。
  case "$local_sha$remote_sha" in
    *[!0]*)
      case "$remote_sha" in
        *[!0]*) AAS_PUSH_RANGE="$remote_sha..$local_sha" ;;
      esac
      ;;
  esac
done

if [ "$pushing_wip" = "1" ]; then
  echo "== wip/ のブランチなので、確かめずに通します（作業中のものを移すだけ）"
  echo "   ここを取り込むときは、取り込んだ先で確かめてください。"
  exit 0
fi

# git がフックへ渡す env を、確かめへ持ち込まない。
#
# git は pre-push に GIT_DIR・GIT_INDEX_FILE などを渡す。継いだまま試験を
# 回すと、一時の repository を作る試験が**走らせている repository** を
# 触りにいって落ちる。手で回すと通り、フックからだけ 21 件落ちた。
# **確かめの側が嘘をつくと、確かめを迂回する癖がつく。**
unset GIT_DIR GIT_WORK_TREE GIT_INDEX_FILE GIT_PREFIX GIT_QUARANTINE_PATH
unset GIT_REFLOG_ACTION GIT_OBJECT_DIRECTORY GIT_ALTERNATE_OBJECT_DIRECTORIES

# 文書だけの push は、そのまま出さない。
#
# ci.yml の paths-ignore は効かない（GitHub は pull_request の path 判定を
# PR 全体の差分で行うので、PR に一度でもコードが入っていれば当たらない）。
# この repo は push では回さないので、**開いている PR への文書だけの push は
# 毎回 1 回ぶん枠を食う**。実際に食った。
#
# 押す範囲は、上で読んだ remote_ref/local_sha から出す。remote にまだ
# 枝が無い（_remote_sha が全部 0）ときは、範囲が決められないので見ない。
if [ -n "$AAS_PUSH_RANGE" ]; then
  reason=$(node scripts/docs-only-check.mjs "$AAS_PUSH_RANGE") || {
    echo "$reason"
    exit 1
  }
fi

echo "== push の手前で確かめます（型検査・検査・画面）"
node scripts/check.mjs
