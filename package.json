{
  "name": "adaptive-ai-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "モデル非依存のAI開発基盤",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "doctor": "node --experimental-strip-types --no-warnings src/cli/doctor.ts",
    "chat": "node --experimental-strip-types --no-warnings src/cli/main.ts",
    "test": "node scripts/run-tests.mjs",
    "typecheck": "tsc --noEmit",
    "agent": "node --experimental-strip-types --no-warnings src/cli/agent.ts",
    "team": "node --experimental-strip-types --no-warnings src/cli/team.ts",
    "models": "node --experimental-strip-types --no-warnings src/cli/models.ts",
    "ui": "node --experimental-strip-types --no-warnings src/cli/ui.ts",
    "update": "node --experimental-strip-types --no-warnings src/cli/update.ts",
    "llama": "node --experimental-strip-types --no-warnings src/cli/llama.ts",
    "selftest": "node --experimental-strip-types --no-warnings src/cli/selftest.ts"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/sdk": "^0.71.0"
  }
}
